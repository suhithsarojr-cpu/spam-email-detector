# Copy to ".env" and adjust. No API keys are needed for core functionality.
DATABASE_URL=sqlite:///./spam_detector.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to false to never store email text (only label + confidence are saved)
STORE_EMAIL_TEXT=true
MAX_SUBJECT_CHARS=300
MAX_BODY_CHARS=20000
MAX_USERS=50
RATE_LIMIT_PER_MIN=30
